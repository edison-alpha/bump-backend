# bump backend (Elysia on Bun). Copy to .env; Bun loads it automatically. Never commit .env.

PORT=3300

# Somnia Hideki testnet (50383). Empty uses the SDK's chain definition (api.hideki2.infra.testnet.somnia.network).
HIDEKI_RPC_URL=

# Database: a postgres:// URL (Supabase, Neon) or empty for embedded PGlite in .bump-db.
DATABASE_URL=
BUMP_PGLITE_DIR=.bump-db

# Session cookie signing key (required in production; generated locally otherwise).
SESSION_SECRET=

# Privy (dashboard.privy.io -> app -> Settings): app id and app secret, used to verify access tokens and linked wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Browser origins allowed to call the API, comma-separated.
BUMP_ALLOWED_ORIGINS=http://localhost:3200
# Set to 1 when the frontend and API are on different sites (cookie becomes SameSite=None; Secure; Partitioned).
BUMP_CROSS_SITE_COOKIE=

# STT faucet: a funded Hideki key that drips gas money to new players. Server only; never a player's key.
FAUCET_PRIVATE_KEY=
# STT sent per drip: gas plus 0.3 STT for one TP/SL pair (0.15 per stop).
BUMP_DRIP_STT=0.5
# Wallets holding at least this much get nothing.
BUMP_DRIP_MIN_STT=0.35
BUMP_DRIP_COOLDOWN_HOURS=24

# Trade logs are checked against the transaction receipt on Hideki. 0 turns that off (local development only).
BUMP_VERIFY_TX=1

# Local development only: POST /api/session/dev signs in with a wallet signature, without Privy.
BUMP_DEV_AUTH=

# Production: the app is on https://bump-ten-beta.vercel.app, the API is served at https://api.paymom3nts.xyz
